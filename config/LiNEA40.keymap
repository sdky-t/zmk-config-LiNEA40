#define ZMK_POINTING_DEFAULT_SCRL_VAL 150

#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define MOUSE 1
#define MARK 2
#define CURSOR 3
#define FUNCTION 4
#define SCROLL 5
#define WIRELESS 6

//mouse cursol

&mmv {
    delay-ms = <20>;
    trigger-period-ms = <5>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <2>;
};

//mouse scroll

&msc {
    delay-ms = <3>;
    trigger-period-ms = <3>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <0>;
};

/ {
    input_processors {
        zip_wheel_scaler: zip_wheel_scaler {
            compatible = "zmk,input-processor-scaler";
            #input-processor-cells = <2>;
            type = <INPUT_EV_REL>;
            codes = <INPUT_REL_WHEEL>;
            track-remainders;
        };
    };
};

&msc_input_listener {
    speed_up {
        layers = <FUNCTION>;
        input-processors = <&zip_wheel_scaler 3 1>; //スクロールを3倍速にする
    };
};

&trackball_listener {
    scroller {
        layers = <SCROLL>;
        input-processors =
            <&zip_xy_transform INPUT_TRANSFORM_Y_INVERT>,
            //スクロール方向を逆転,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,
            <&zip_xy_to_scroll_mapper>,
            <&zip_scroll_scaler 1 12>;
    };
};

/ {
    combos {
        compatible = "zmk,combos";

        kakko_left {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <2 3>;
            layers = <0 1 2>;
            timeout-ms = <40>;
            require-prior-idle-ms = <120>;
        };

        kakko_right {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <6 7>;
            layers = <0 1 2>;
            timeout-ms = <40>;
            require-prior-idle-ms = <120>;
        };

        daikakko_left {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <12 13>;
            layers = <0 1 2>;
            timeout-ms = <40>;
            require-prior-idle-ms = <120>;
        };

        daikakko_right {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <16 17>;
            layers = <1 0 2>;
            timeout-ms = <40>;
            require-prior-idle-ms = <120>;
        };

        chukakko_left {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <22 23>;
            layers = <0 1 2>;
            timeout-ms = <40>;
            require-prior-idle-ms = <120>;
        };

        chukakko_right {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <26 27>;
            layers = <0 1 2>;
            timeout-ms = <40>;
            require-prior-idle-ms = <120>;
        };

        colon {
            bindings = <&kp COLON>;
            key-positions = <13 14>;
            timeout-ms = <40>;
            require-prior-idle-ms = <120>;
            layers = <0 1 2>;
        };

        semicolon {
            bindings = <&kp SEMICOLON>;
            key-positions = <15 16>;
            timeout-ms = <40>;
            require-prior-idle-ms = <120>;
            layers = <0 1 2>;
        };

        doublequote {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <3 4>;
            timeout-ms = <40>;
            require-prior-idle-ms = <120>;
            layers = <0 1 2>;
        };

        quote {
            bindings = <&kp SQT>;
            key-positions = <6 5>;
            timeout-ms = <40>;
            require-prior-idle-ms = <120>;
            layers = <0 1 2>;
        };

        at {
            bindings = <&kp RS(NUMBER_2)>;
            key-positions = <12 13>;
            timeout-ms = <40>;
            require-prior-idle-ms = <120>;
            layers = <5 6>;
        };
    };

    behaviors {
        re_kp: sensor_rotate_kp {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&kp>, <&kp>;
        };

        mouse_scrl: mouse_wheel_scrl {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>;
        };

        volume_up_down: volume_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            label = "VOLUME_UP_DOWN";
            #sensor-binding-cells = <0>;
            bindings = <&kp C_VOLUME_UP>, <&kp C_VOLUME_DOWN>;

            tap-ms = <20>;
        };

        mt_L0EN: mt_L0EN {
            compatible = "zmk,behavior-hold-tap";
            label = "MT_L0EN";
            bindings = <&kp>, <&EN_to_L0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        mt_L1JP: mt_L1JP {
            compatible = "zmk,behavior-hold-tap";
            label = "MT_L1JP";
            bindings = <&kp>, <&JP_to_L1>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        mt_qs_on: mt_qs_on {
            compatible = "zmk,behavior-hold-tap";
            label = "MT_QS_ON";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            flavor = "tap-preferred";
        };

        lt_qs_on: lt_qs_on {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_QS_ON";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            flavor = "tap-preferred";
        };

        rotate_test: rotate_test {
            compatible = "zmk,behavior-sensor-rotate-var";
            label = "ROTATE_TEST";
            #sensor-binding-cells = <2>;
            bindings = <&sss>, <&ddd>;

            tap-ms = <200>;
        };
    };

    macros {
        EN_to_L0: EN_to_L0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &kp LANG2>;
            label = "EN_TO_L0";
        };

        JP_to_L1: JP_to_L1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 1 &kp LANGUAGE_1>;
            label = "JP_TO_L1";
        };

        kakko: kakko {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LANGUAGE_2 &kp LEFT_PARENTHESIS &kp RIGHT_PARENTHESIS &kp LEFT>;
            label = "KAKKO";
        };

        doublequote: new_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LANGUAGE_2 &kp DOUBLE_QUOTES &kp DOUBLE_QUOTES &kp LEFT>;
            label = "NEW_MACRO";
        };

        kagikakko: kagikakko {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LANGUAGE_1 &kp LEFT_BRACKET &kp RIGHT_BRACKET &kp SPACE &kp ENTER &kp LEFT>;
            label = "KAGIKAKKO";
        };

        sss: sss {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp RIGHT_CONTROL>,
                <&macro_press>,
                <&macro_wait_time 20>,
                <&kp K_SCROLL_UP>,
                <&macro_tap>,
                <&macro_wait_time 20>,
                <&kp RIGHT_CONTROL>,
                <&macro_release>,
                <&macro_wait_time 20>;

            label = "SSS";
        };

        ddd: ddd {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp RIGHT_CONTROL>,
                <&macro_press>,
                <&macro_wait_time 20>,
                <&kp Z>,
                <&macro_tap>,
                <&macro_wait_time 20>,
                <&kp RIGHT_CONTROL>,
                <&macro_release>,
                <&macro_wait_time 20>;

            label = "DDD";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q                     &kp W               &lt_qs_on 7 E          &lt_qs_on 5 R      &kp T                                                                           &kp Y              &kp U          &kp I                &kp O          &mt_qs_on LEFT_ALT P
&mt_qs_on LEFT_CONTROL A  &kp S               &kp D                  &lt_qs_on 8 F      &kp G                                                                           &kp H              &lt_qs_on 8 J  &kp K                &kp L          &lt_qs_on 9 MINUS
&mt_qs_on RC(Z) Z         &mt_qs_on RC(X) X   &mt_qs_on RC(C) C      &mt_qs_on RC(V) V  &mt_qs_on RC(Y) B                                                               &kp N              &kp M          &kp COMMA            &kp DOT        &lt_qs_on 8 SLASH
&mt LCTRL ESC             &mt LEFT_SHIFT TAB  &mt LEFT_ALT LEFT_WIN  &none              &mt_qs_on RIGHT_SHIFT SPACE  &mt_L1JP RIGHT_CONTROL 0    &lt_qs_on 7 BACKSPACE  &lt_qs_on 5 ENTER                 &lt_qs_on 10 ESCAPE  &kp RIGHT_WIN  &mt_qs_on RIGHT_CONTROL BACKSLASH
            >;

            sensor-bindings = <&mouse_scrl SCRL_DOWN SCRL_UP>;
        };

        OHNISHI {
            bindings = <
&kp Q                     &kp L              &lt_qs_on 7 U      &lt_qs_on 5 COMMA  &kp PERIOD                                                 &kp F              &kp W          &kp R   &kp Y   &mt_qs_on LEFT_ALT P
&mt_qs_on LEFT_CONTROL E  &kp I              &kp A              &lt_qs_on 8 O      &kp MINUS                                                  &kp K              &lt_qs_on 8 T  &kp N   &kp S   &lt_qs_on 9 H
&mt_qs_on RC(Z) Z         &mt_qs_on RC(X) X  &mt_qs_on RC(C) C  &mt_qs_on RC(V) V  &mt_qs_on RC(Y) SLASH                                      &kp G              &kp D          &kp M   &kp J   &lt_qs_on 8 B
&trans                    &trans             &trans             &trans             &trans                 &mt_L1JP RIGHT_CONTROL 0    &trans  &lt_qs_on 5 ENTER                 &trans  &trans  &trans
            >;

            sensor-bindings = <&mouse_scrl SCRL_DOWN SCRL_UP>;
        };

        default_not_ohnishi {
            bindings = <
&kp Q                     &kp W               &lt_qs_on 7 E          &lt_qs_on 6 R      &kp T                                                                                     &kp Y              &kp U          &kp I                &kp O          &mt_qs_on LEFT_ALT P
&mt_qs_on LEFT_CONTROL A  &kp S               &kp D                  &lt_qs_on 8 F      &kp G                                                                                     &kp H              &lt_qs_on 8 J  &kp K                &kp L          &lt_qs_on 9 MINUS
&mt_qs_on RC(Z) Z         &mt_qs_on RC(X) X   &mt_qs_on RC(C) C      &mt_qs_on RC(V) V  &mt_qs_on RC(Y) B                                                                         &kp N              &kp M          &kp COMMA            &kp DOT        &lt_qs_on 8 SLASH
&mt LCTRL ESC             &mt LEFT_SHIFT TAB  &mt LEFT_ALT LEFT_WIN  &none              &mt_qs_on RIGHT_SHIFT SPACE  &mt_qs_on RIGHT_CONTROL LANGUAGE_1    &lt_qs_on 7 BACKSPACE  &lt_qs_on 6 ENTER                 &lt_qs_on 10 ESCAPE  &kp RIGHT_WIN  &mt_qs_on RIGHT_CONTROL BACKSLASH
            >;

            sensor-bindings = <&mouse_scrl SCRL_DOWN SCRL_UP>;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                                        &trans  &trans    &trans           &mo 4              &trans
&trans  &trans  &trans  &trans  &trans                                        &trans  &mkp MB1  &mkp MB2         &mo 7              &trans
&trans  &trans  &trans  &trans  &trans                                        &trans  &trans    &kp RIGHT_SHIFT  &kp RIGHT_CONTROL  &trans
&trans  &trans  &trans  &trans  &kp RIGHT_SHIFT  &kp RIGHT_CONTROL    &trans  &trans            &trans           &trans             &trans
            >;
        };

        slow {
            bindings = <
&trans  &trans  &trans  &trans  &trans                                &trans  &trans    &trans           &trans     &trans
&trans  &trans  &trans  &trans  &trans                                &trans  &mkp MB1  &mkp MB2         &mo 7      &trans
&trans  &trans  &trans  &trans  &trans                                &trans  &trans    &kp RIGHT_SHIFT  &kp RCTRL  &trans
&trans  &trans  &trans  &trans  &kp RIGHT_SHIFT  &kp RCTRL    &trans  &trans            &trans           &trans     &trans
            >;
        };

        num_func {
            bindings = <
&kp F9  &kp F10  &kp F11  &kp F12  &kp RC(F)                                          &kp PLUS      &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp MINUS
&kp F5  &kp F6   &kp F7   &kp F8   &kp RG(V)                                          &kp PERIOD    &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp NUMBER_0
&kp F1  &kp F2   &kp F3   &kp F4   &kp RG(RS(S))                                      &kp ASTERISK  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp SLASH
&trans  &trans   &trans   &trans   &kp RS(MINUS)  &mt_L0EN RIGHT_CONTROL 0    &trans  &trans                      &none         &kp PERCENT   &kp EQUAL
            >;

            sensor-bindings = <&mouse_scrl SCRL_RIGHT SCRL_LEFT>;
        };

        num_not_ohnishi {
            bindings = <
&kp F9  &kp F10  &kp F11  &kp F12  &kp RC(F)                                                    &kp PLUS      &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp MINUS
&kp F5  &kp F6   &kp F7   &kp F8   &kp RG(V)                                                    &kp PERIOD    &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp NUMBER_0
&kp F1  &kp F2   &kp F3   &kp F4   &kp RG(RS(S))                                                &kp ASTERISK  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp SLASH
&trans  &trans   &trans   &trans   &kp RS(MINUS)  &mt_qs_on RIGHT_CONTROL LANGUAGE_2    &trans  &trans                      &none         &kp PERCENT   &kp EQUAL
            >;

            sensor-bindings = <&mouse_scrl SCRL_RIGHT SCRL_LEFT>;
        };

        symbol_scroll {
            bindings = <
&kp ESCAPE  &trans  &trans  &kp LEFT_BRACKET  &kp RIGHT_BRACKET                    &kakko        &kp AMPERSAND    &kp DOLLAR    &kp TILDE  &kp MINUS
&kp TAB     &trans  &trans  &kp SEMICOLON     &kp COLON                            &doublequote  &kp AT_SIGN      &kp HASH      &kp CARET  &kp UNDERSCORE
&trans      &trans  &trans  &kp SQT           &kp DOUBLE_QUOTES                    &kagikakko    &kp EXCLAMATION  &kp QUESTION  &kp TILDE  &kp MINUS
&trans      &trans  &trans  &trans            &trans             &trans    &trans  &trans                         &trans        &trans     &trans
            >;

            sensor-bindings = <&re_kp F17 F18>;
        };

        ctrl_office {
            bindings = <
&kp RA(Q)  &kp RA(W)  &kp RA(E)  &kp RA(R)  &trans                                                 &trans         &kp HOME   &kp UP_ARROW  &kp END    &trans
&kp RA(A)  &kp RA(S)  &kp RA(D)  &kp RA(F)  &kp ENTER                                              &kp RC(Z)      &kp LEFT   &kp DOWN      &kp RIGHT  &trans
&kp RA(Z)  &kp RA(X)  &kp RA(C)  &kp RA(V)  &kp DELETE                                             &kp RC(Y)      &kp RC(C)  &kp RC(X)     &kp RC(V)  &trans
&trans     &trans     &trans     &trans     &mt_qs_on RIGHT_SHIFT SPACE  &kp BACKSPACE    &kp DEL  &kp RIGHT_WIN             &trans        &trans     &trans
            >;

            sensor-bindings = <&re_kp Z Y>;
        };

        browse_snipe {
            bindings = <
&trans  &trans  &trans  &trans  &trans                                   &kp RC(T)          &kp F15          &kp F16        &trans  &trans
&trans  &trans  &trans  &trans  &trans                                   &kp RC(W)          &kp RS(RC(TAB))  &kp RC(TAB)    &kp F5  &trans
&trans  &trans  &trans  &trans  &trans                                   &kp RC(RS(T))      &kp RA(LEFT)     &kp RA(RIGHT)  &trans  &trans
&trans  &trans  &trans  &trans  &kp RC(RG(LEFT))  &trans    &kp RG(TAB)  &kp LG(LC(RIGHT))                   &trans         &trans  &trans
            >;

            sensor-bindings = <&re_kp C_VOLUME_DOWN C_VOLUME_UP>;
        };

        WIRELESS {
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                         &bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans        &trans        &trans        &trans        &trans                               &to 0           &to 2         &trans        &trans        &trans
&trans        &trans        &trans        &trans        &trans                               &trans          &trans        &trans        &trans        &bt BT_CLR
&trans        &trans        &trans        &trans        &trans        &trans    &bootloader  &studio_unlock                &trans        &trans        &bt BT_CLR_ALL
            >;

            sensor-bindings = <&inc_dec_kp RIGHT_ARROW LEFT_ARROW>;
        };
    };
};
